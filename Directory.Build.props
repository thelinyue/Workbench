    <InformationalVersion>2.0.1</InformationalVersion>
    <Company>Hephaestus Workbench</Company>
    <Product>Hephaestus工作台</Product>
    <Title>Hephaestus工作台</Title>
    <Description>Hephaestus工作台 Windows 本地日志分析工作台</Description>
  </PropertyGroup>
</Project>
