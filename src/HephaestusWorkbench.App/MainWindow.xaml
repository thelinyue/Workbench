<Window x:Class="HephaestusWorkbench.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="800" Width="1320" MinHeight="720" MinWidth="1180"
        WindowStartupLocation="CenterScreen" Icon="Assets/AppIcon/app-icon.ico">
    <Grid Background="{DynamicResource WorkbenchBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- v2 导航由 Host 固定定义；扩展只能从扩展中心打开，不能向侧栏注册页面。 -->
        <Border Grid.RowSpan="3" Background="{DynamicResource WorkbenchNavBrush}"
                BorderBrush="{DynamicResource WorkbenchBorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="20,20,18,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource WorkbenchPrimaryBrush}">
                            <TextBlock Text="H" Foreground="{DynamicResource WorkbenchOnPrimaryBrush}" FontSize="17" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="HEPHAESTUS" FontSize="13" FontWeight="Bold" />
                            <TextBlock Text="WORKBENCH" Style="{StaticResource MutedTextStyle}" FontSize="10" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding NavigationSections}" Margin="10,0,10,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource MutedTextStyle}" FontSize="11"
                                           FontWeight="SemiBold" Margin="12,0,0,6" />
                                <ListBox ItemsSource="{Binding Items}"
                                         SelectedItem="{Binding DataContext.SelectedNavigationItem, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                         BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="Margin" Value="0,0,0,3" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="NavItem" Background="Transparent" BorderBrush="Transparent"
                                                                BorderThickness="3,0,0,0" CornerRadius="6" Padding="12,10">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="NavItem" Property="Background" Value="{DynamicResource WorkbenchHoverBrush}" />
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="NavItem" Property="Background" Value="{DynamicResource WorkbenchSelectedBrush}" />
                                                                <Setter TargetName="NavItem" Property="BorderBrush" Value="{DynamicResource WorkbenchPrimaryBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons" FontSize="16" Width="28" />
                                                <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="2" Text="{Binding AppVersion}" Style="{StaticResource MutedTextStyle}" Margin="20,0,18,18" />
            </Grid>
        </Border>

        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource WorkbenchSurfaceBrush}"
                BorderBrush="{DynamicResource WorkbenchBorderBrush}" BorderThickness="0,0,0,1" Padding="24,0,20,0">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding PageTitle}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PageContext}" Style="{StaticResource MutedTextStyle}" FontSize="14" Margin="8,4,0,0" />
                    </StackPanel>
                    <Button Content="{Binding GlobalWarningText}" Command="{Binding OpenGlobalWarningCommand}"
                            HorizontalAlignment="Left" BorderThickness="0" Padding="0" Background="Transparent"
                            Foreground="{DynamicResource WorkbenchWarningBrush}"
                            Visibility="{Binding HasGlobalWarning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Margin="24,20,20,18">
            <ContentControl Content="{Binding CurrentPage}" />
        </Grid>

        <Border Grid.Row="2" Grid.Column="1" Background="{DynamicResource WorkbenchSurfaceAltBrush}"
                BorderBrush="{DynamicResource WorkbenchBorderBrush}" BorderThickness="0,1,0,0" Padding="24,0,20,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Fill="{DynamicResource WorkbenchSuccessBrush}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding StatusMessage}" ToolTip="{Binding StatusMessage}"
                           Foreground="{DynamicResource WorkbenchMutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
