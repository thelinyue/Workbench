<Window x:Class="HephaestusWorkbench.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="赫菲斯托斯工程工作台（赫工）" Height="760" Width="1280" MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/AppIcon/app-icon.ico">
    <Grid Background="{DynamicResource WorkbenchBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource WorkbenchSurfaceBrush}" BorderBrush="{DynamicResource WorkbenchBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" Background="{DynamicResource WorkbenchPrimaryBrush}" CornerRadius="3" Margin="0,0,10,0"><TextBlock Text="赫工" Foreground="{DynamicResource WorkbenchOnPrimaryBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel><TextBlock Text="赫菲斯托斯工程工作台" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Hephaestus Workbench · 日志分析工作台" Style="{StaticResource MutedTextStyle}"/></StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource WorkbenchAccentBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ActivityStatus}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PluginStatus}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding StorageStatus}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Command="{Binding OpenSettingsCommand}" Padding="8,5" Margin="0" ToolTip="设置"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons"/></Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource WorkbenchSurfaceBrush}" BorderBrush="{DynamicResource WorkbenchBorderBrush}" BorderThickness="0,0,1,0" Padding="8,12">
            <ListBox ItemsSource="{Binding NavigationItems}" SelectedItem="{Binding SelectedNavigationItem}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Margin" Value="0,0,0,3"/><Setter Property="Padding" Value="0"/>
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="3,0,0,0" CornerRadius="2" Padding="11,9"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource WorkbenchHoverBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource WorkbenchSelectedBrush}"/><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource WorkbenchPrimaryBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons" FontSize="16" Width="30" VerticalAlignment="Center"/><TextBlock Text="{Binding Title}" VerticalAlignment="Center"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Margin="20,16,20,16">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="{Binding PageTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14"/>
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}"/>
        </Grid>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource WorkbenchPrimaryBrush}" Padding="8,0">
            <DockPanel><TextBlock Text="赫工 · Hephaestus Workbench" Foreground="{DynamicResource WorkbenchOnPrimaryBrush}" FontSize="12" VerticalAlignment="Center"/><TextBlock DockPanel.Dock="Right" Text="{Binding StatusMessage}" Foreground="{DynamicResource WorkbenchOnPrimaryBrush}" FontSize="12" VerticalAlignment="Center"/></DockPanel>
        </Border>
    </Grid>
</Window>
