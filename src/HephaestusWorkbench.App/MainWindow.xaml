<Window x:Class="HephaestusWorkbench.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="760" Width="1280" MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/AppIcon/app-icon.ico">
    <Grid Background="{DynamicResource WorkbenchBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource WorkbenchSurfaceBrush}" BorderBrush="{DynamicResource WorkbenchBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0,12,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" MinWidth="0">
                    <TextBlock Text="{Binding PageTitle}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding PageContext}" Style="{StaticResource MutedTextStyle}" FontSize="13" Margin="7,1,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource WorkbenchSurfaceAltBrush}" CornerRadius="10" Padding="7,3" Margin="0,0,8,0" ToolTip="当前客户端版本">
                        <TextBlock Text="{Binding AppVersion}" Foreground="{DynamicResource WorkbenchMutedTextBrush}" FontSize="11"/>
                    </Border>
                    <Button Content="&#xEA8F;" FontFamily="Segoe Fluent Icons" Command="{Binding OpenGlobalWarningCommand}" ToolTip="{Binding GlobalWarningText}" AutomationProperties.Name="全局异常提醒" Padding="9,6" Margin="0,0,6,0" Visibility="{Binding HasGlobalWarning, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="{DynamicResource WorkbenchWarningBrush}"/>
                    <Button x:Name="TaskButton" Command="{Binding TaskPanel.ToggleCommand}" ToolTip="{Binding TaskPanel.ButtonToolTip}" AutomationProperties.Name="后台任务" Padding="9,5" Margin="0">
                        <Grid>
                            <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource WorkbenchDangerBrush}" CornerRadius="8" MinWidth="16" Height="16" Padding="3,0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12,-7,-8,0" Visibility="{Binding TaskPanel.HasActiveTasks, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding TaskPanel.ActiveTaskCount}" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>
                    <Popup PlacementTarget="{Binding ElementName=TaskButton}" Placement="Bottom" HorizontalOffset="-330" VerticalOffset="4" AllowsTransparency="True" StaysOpen="False" DataContext="{Binding TaskPanel}" IsOpen="{Binding IsOpen, Mode=TwoWay}">
                        <Border Width="380" MaxHeight="520" Background="{DynamicResource WorkbenchSurfaceBrush}" BorderBrush="{DynamicResource WorkbenchBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Content="刷新" Command="{Binding RefreshCommand}" Padding="8,4" Margin="8,0,0,0"/>
                                    <StackPanel><TextBlock Text="后台任务" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="活动任务与最近结果" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0"/></StackPanel>
                                </DockPanel>
                                <Grid Grid.Row="1">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                <Border BorderBrush="{DynamicResource WorkbenchBorderBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <Button Command="{Binding DataContext.OpenTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Left">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding CaseName}" FontWeight="SemiBold"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="{Binding PluginId}" Style="{StaticResource MutedTextStyle}"/><TextBlock Text=" · " Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding TimeText}" Style="{StaticResource MutedTextStyle}"/></StackPanel>
                                                                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource WorkbenchDangerBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,8,0" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                            <Border Background="{Binding StatusValue, Converter={StaticResource StatusBrushConverter}}" CornerRadius="10" Padding="8,3"><TextBlock Text="{Binding StatusValue, Converter={StaticResource StatusTextConverter}}" FontSize="12"/></Border>
                                                            <Button Content="取消" Command="{Binding DataContext.CancelTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Padding="7,3" Margin="0,5,0,0" Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock Text="暂无后台任务" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" Margin="0,24" Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource WorkbenchSurfaceBrush}" BorderBrush="{DynamicResource WorkbenchBorderBrush}" BorderThickness="0,0,1,0" Padding="8,12">
            <ListBox ItemsSource="{Binding NavigationItems}" SelectedItem="{Binding SelectedNavigationItem}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Margin" Value="0,0,0,3"/><Setter Property="Padding" Value="0"/>
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="3,0,0,0" CornerRadius="2" Padding="11,9"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource WorkbenchHoverBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource WorkbenchSelectedBrush}"/><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource WorkbenchPrimaryBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons" FontSize="16" Width="30" VerticalAlignment="Center"/><TextBlock Text="{Binding Title}" VerticalAlignment="Center"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Margin="20,16,20,16">
            <ContentControl Content="{Binding CurrentPage}"/>
        </Grid>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource WorkbenchSurfaceAltBrush}" BorderBrush="{DynamicResource WorkbenchBorderBrush}" BorderThickness="0,1,0,0" Padding="10,0">
            <TextBlock Text="{Binding StatusMessage}" ToolTip="{Binding StatusMessage}" Foreground="{DynamicResource WorkbenchMutedTextBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>
