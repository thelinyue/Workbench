<Window x:Class="HephaestusWorkbench.App.Views.WorkspaceHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="扩展工作区"
        Width="1280"
        Height="860"
        MinWidth="900"
        MinHeight="650"
        WindowStartupLocation="CenterOwner">
    <Grid Background="{DynamicResource WorkbenchBackgroundBrush}">
        <wv2:WebView2 x:Name="Browser"
                      automation:AutomationProperties.Name="扩展工作区内容" />
        <Border x:Name="ErrorPanel"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="620"
                Padding="18"
                Background="{DynamicResource WorkbenchErrorOverlayBrush}">
            <TextBlock x:Name="ErrorText"
                       Foreground="{DynamicResource WorkbenchTextBrush}"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
