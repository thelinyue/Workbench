<UserControl x:Class="HephaestusWorkbench.App.Views.ReportPage"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="MoreMenuStyle" TargetType="Menu">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MoreMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource WorkbenchTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource WorkbenchSurfaceAltBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style x:Key="ReportFilterLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Border x:Name="ReportTabStrip"
                Style="{StaticResource TabStripStyle}"
                Padding="10,8"
                Margin="0,0,0,10"
                Visibility="{Binding HasOpenTabs, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="报告工作区" FontWeight="SemiBold"/>
                    <TextBlock Text="OPEN REPORTS" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0"/>
                </StackPanel>
                <Button DockPanel.Dock="Left" Content="报告列表" Command="{Binding ShowLibraryCommand, ElementName=Root}" Click="OnShowLibraryClick" Margin="0,0,8,0" ToolTip="返回报告列表" AutomationProperties.Name="报告列表"/>
                <Button DockPanel.Dock="Right" Content="打开解压目录" Command="{Binding OpenSelectedExtractDirectoryCommand}" Margin="8,0,0,0" Visibility="{Binding IsLibraryVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding OpenTabs}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="1" CornerRadius="3" Margin="0,0,6,0" Padding="10,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource WorkbenchSurfaceAltBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource WorkbenchBorderBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource WorkbenchSelectedBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource WorkbenchPrimaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- DataTemplate 有独立命名范围，使用 UserControl 祖先稳定回到报告工作区。 -->
                                        <Button Content="{Binding Title}" Command="{Binding DataContext.OpenTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,8,0" AutomationProperties.Name="打开报告标签"/>
                                        <Button Content="×" Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="3,0" Margin="0" ToolTip="关闭报告" AutomationProperties.Name="关闭报告"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 报告库内部切换了 DataContext，显示状态必须显式回到工作区根模型。 -->
        <Grid Grid.Row="1" Visibility="{Binding DataContext.IsLibraryVisible, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}" DataContext="{Binding Library}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <Border x:Name="ReportLibraryToolbar" Style="{StaticResource WorkspacePanelStyle}" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Right" Text="REPORT LIBRARY" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="报告库" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                            <TextBlock Text="筛选、打开和管理已生成的分析报告" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <WrapPanel>
                        <StackPanel Margin="0,0,10,6"><TextBlock Text="搜索" Style="{StaticResource ReportFilterLabelStyle}"/><TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" Width="220" ToolTip="搜索案例、设备或插件"/></StackPanel>
                        <StackPanel Margin="0,0,10,6"><TextBlock Text="设备 ID" Style="{StaticResource ReportFilterLabelStyle}"/><TextBox Text="{Binding DeviceId, UpdateSourceTrigger=PropertyChanged}" Width="150"/></StackPanel>
                        <StackPanel Margin="0,0,10,6"><TextBlock Text="插件" Style="{StaticResource ReportFilterLabelStyle}"/><ComboBox ItemsSource="{Binding PluginOptions}" SelectedItem="{Binding SelectedPlugin}" DisplayMemberPath="Name" Width="150"/></StackPanel>
                        <StackPanel Margin="0,0,10,6"><TextBlock Text="开始日期" Style="{StaticResource ReportFilterLabelStyle}"/><DatePicker SelectedDate="{Binding StartDate}" Width="135"/></StackPanel>
                        <StackPanel Margin="0,0,10,6"><TextBlock Text="结束日期" Style="{StaticResource ReportFilterLabelStyle}"/><DatePicker SelectedDate="{Binding EndDate}" Width="135"/></StackPanel>
                        <Button Content="刷新" Command="{Binding RefreshCommand}" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                    </WrapPanel>
                    <TextBlock Text="删除报告会同时删除所属案例、原始日志和解压目录。" Foreground="{DynamicResource WorkbenchDangerBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding Message}" Foreground="{DynamicResource WorkbenchWarningBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource CommandStripStyle}" Padding="10,8" Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="案例 / 报告位置" Style="{StaticResource TableHeaderStyle}"/>
                    <TextBlock Grid.Column="1" Text="设备 / 插件" Style="{StaticResource TableHeaderStyle}"/>
                    <TextBlock Grid.Column="2" Text="生成时间" Style="{StaticResource TableHeaderStyle}"/>
                    <TextBlock Grid.Column="3" Text="操作" Style="{StaticResource TableHeaderStyle}"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <ListBox ItemsSource="{Binding Items}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource WorkbenchBorderBrush}" BorderThickness="0,0,0,1" Padding="10,11">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="{Binding CaseName}" FontWeight="SemiBold" ToolTip="{Binding CaseName}"/>
                                        <TextBlock Text="{Binding Path}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding DeviceId}" ToolTip="{Binding DeviceId}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding PluginName}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding CreateTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}"/>
                                        <TextBlock Text="可用" Foreground="{DynamicResource WorkbenchSuccessBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <WrapPanel Grid.Column="3" VerticalAlignment="Center">
                                        <Button Content="打开" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Margin="0"/>
                                        <Menu Style="{StaticResource MoreMenuStyle}" ToolTip="更多操作" Margin="6,0,0,0">
                                            <MenuItem Header="更多" Style="{StaticResource MoreMenuItemStyle}">
                                                <MenuItem Header="打开案例" Command="{Binding DataContext.OpenCaseCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                                <MenuItem Header="报告位置" Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                                <MenuItem Header="解压目录" Command="{Binding DataContext.OpenExtractDirectoryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                                <Separator/>
                                                <MenuItem Header="删除报告及全部数据" Foreground="{DynamicResource WorkbenchDangerBrush}" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                            </MenuItem>
                                        </Menu>
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons" FontSize="34" Foreground="{DynamicResource WorkbenchMutedTextBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="暂无匹配报告" FontSize="16" Margin="0,10,0,0"/>
                    <TextBlock Text="调整搜索条件或等待新的分析任务完成" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>

        <ContentControl x:Name="ViewerHost" Grid.Row="1" Visibility="{Binding DataContext.IsLibraryVisible, ElementName=Root, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
    </Grid>
</UserControl>
