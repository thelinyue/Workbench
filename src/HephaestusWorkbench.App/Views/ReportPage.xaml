<UserControl x:Class="HephaestusWorkbench.App.Views.ReportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:HephaestusWorkbench.App.Views">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Style="{StaticResource CardStyle}" Padding="8" Margin="0,0,0,10" Visibility="{Binding HasOpenTabs, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="分析列表" Command="{Binding ShowLibraryCommand}" Margin="0,0,8,0" ToolTip="返回分析中心列表"/>
                <Button DockPanel.Dock="Right" Content="打开解压目录" Command="{Binding OpenSelectedExtractDirectoryCommand}" Margin="8,0,0,0" Visibility="{Binding IsLibraryVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                <ItemsControl ItemsSource="{Binding OpenTabs}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Background="{DynamicResource WorkbenchSurfaceAltBrush}" BorderBrush="{DynamicResource WorkbenchBorderBrush}" BorderThickness="1" CornerRadius="2" Margin="0,0,6,0" Padding="10,5">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding Title}" Command="{Binding DataContext.OpenTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,8,0"/>
                                <Button Content="×" Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="3,0" Margin="0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Visibility="{Binding IsLibraryVisible, Converter={StaticResource BooleanToVisibilityConverter}}" DataContext="{Binding Library}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="查找历史分析结果" Style="{StaticResource SectionTitleStyle}"/>
                    <WrapPanel>
                        <TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" Width="220" ToolTip="搜索案例、设备或插件"/>
                        <TextBox Text="{Binding DeviceId, UpdateSourceTrigger=PropertyChanged}" Width="150" ToolTip="设备 ID"/>
                        <ComboBox ItemsSource="{Binding PluginOptions}" SelectedItem="{Binding SelectedPlugin}" DisplayMemberPath="Name" Width="150"/>
                        <DatePicker SelectedDate="{Binding StartDate}" Width="135" ToolTip="开始日期"/>
                        <DatePicker SelectedDate="{Binding EndDate}" Width="135" ToolTip="结束日期"/>
                        <Button Content="刷新" Command="{Binding RefreshCommand}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding Message}" Foreground="{DynamicResource WorkbenchWarningBrush}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Grid Grid.Row="1">
                <ListBox ItemsSource="{Binding Items}">
                    <ListBox.ItemTemplate><DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,7">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="{Binding CaseName}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{Binding Path}" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="设备" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding DeviceId}" Margin="0,3,0,0"/><TextBlock Text="{Binding PluginName}" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="生成时间" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding CreateTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Margin="0,3,0,0"/><TextBlock Text="可用" Foreground="{DynamicResource WorkbenchSuccessBrush}" Margin="0,5,0,0"/></StackPanel>
                                <WrapPanel Grid.Column="3" VerticalAlignment="Center">
                                    <Button Content="打开" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                    <Button Content="案例" Command="{Binding DataContext.OpenCaseCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                    <Button Content="报告位置" Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                    <Button Content="解压目录" Command="{Binding DataContext.OpenExtractDirectoryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                    <Button Content="删除" Style="{StaticResource DangerButtonStyle}" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Margin="0"/>
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons" FontSize="34" Foreground="{DynamicResource WorkbenchMutedTextBrush}" HorizontalAlignment="Center"/><TextBlock Text="暂无匹配报告" FontSize="16" Margin="0,10,0,0"/><TextBlock Text="调整搜索条件或等待新的分析任务完成" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0"/></StackPanel>
            </Grid>
        </Grid>

        <ContentControl x:Name="ViewerHost" Grid.Row="1" Visibility="{Binding IsLibraryVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
    </Grid>
</UserControl>
