<UserControl x:Class="HephaestusWorkbench.App.Views.SshTerminalPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="SSH 终端">
    <Grid>
        <Border Background="{DynamicResource WorkbenchSurfaceBrush}"
                BorderBrush="{DynamicResource WorkbenchBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="32">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
                <TextBlock Text="&#xE756;" FontFamily="Segoe Fluent Icons" FontSize="36"
                           Foreground="{DynamicResource WorkbenchPrimaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding EmptyTitle}" FontSize="20" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,18,0,0" />
                <TextBlock Text="{Binding EmptyDescription}" Style="{StaticResource MutedTextStyle}"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" />
                <Button Content="新建 SSH 连接" IsEnabled="False" Margin="0,22,0,0"
                        ToolTip="SSH 连接能力将在 SSH Core 阶段启用" AutomationProperties.Name="新建 SSH 连接" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
