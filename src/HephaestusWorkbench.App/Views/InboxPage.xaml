<UserControl x:Class="HephaestusWorkbench.App.Views.InboxPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel><Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Margin="0,0,0,10"><DockPanel><StackPanel><TextBlock Text="待分析日志" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="选择日志包后开始异步分析" Style="{StaticResource MutedTextStyle}"/></StackPanel><WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center"><Button Content="刷新" Command="{Binding RefreshCommand}"/><Button Content="开始分析" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StartCommand}"/><Button Content="删除日志" Style="{StaticResource DangerButtonStyle}" Command="{Binding DeleteCommand}" Margin="0"/></WrapPanel></DockPanel></Border>
        <Grid><ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource CardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding FileName}" FontWeight="SemiBold"/><TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="设备" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding DeviceId}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="日志时间" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding LogTime, StringFormat={}{0:MM-dd HH:mm}}"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="文件大小" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding FileSizeText}"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons" FontSize="36" HorizontalAlignment="Center" Foreground="{DynamicResource WorkbenchMutedTextBrush}"/><TextBlock Text="暂无待分析日志" FontSize="16" Margin="0,10,0,0"/><TextBlock Text="{Binding EmptyStateMessage}" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0"/></StackPanel></Grid>
    </DockPanel>
</UserControl>
