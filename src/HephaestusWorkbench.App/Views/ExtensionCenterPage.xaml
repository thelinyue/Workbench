<UserControl x:Class="HephaestusWorkbench.App.Views.ExtensionCenterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="扩展中心">
    <UserControl.Resources>
        <Style x:Key="ExtensionTabButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="14,7"/>
        </Style>
        <Style x:Key="ExtensionCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel LastChildFill="True" Margin="0,0,0,14">
            <Button DockPanel.Dock="Right"
                    Content="刷新"
                    Command="{Binding RefreshCommand}"
                    AutomationProperties.Name="刷新扩展目录"
                    Margin="12,0,0,0"/>
            <StackPanel>
                <TextBlock Text="安装、更新并管理受信任的工作台扩展。"/>
                <TextBlock Text="{Binding Message}"
                           Style="{StaticResource MutedTextStyle}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource TabStripStyle}" Padding="6" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Content="发现"
                        Command="{Binding SelectDiscoveryTabCommand}"
                        Style="{StaticResource ExtensionTabButtonStyle}"
                        AutomationProperties.Name="显示发现扩展"/>
                <Button Content="已安装"
                        Command="{Binding SelectInstalledTabCommand}"
                        Style="{StaticResource ExtensionTabButtonStyle}"
                        AutomationProperties.Name="显示已安装扩展"/>
                <Button Content="更新"
                        Command="{Binding SelectUpdatesTabCommand}"
                        Style="{StaticResource ExtensionTabButtonStyle}"
                        AutomationProperties.Name="显示扩展更新"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="搜索扩展"
                     ToolTip="按名称、说明、发布者或扩展 ID 搜索"/>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding TypeFilters}"
                      SelectedItem="{Binding SelectedTypeFilter}"
                      AutomationProperties.Name="扩展类型筛选"
                      Margin="0"/>
        </Grid>

        <Grid Grid.Row="3">
            <ListBox ItemsSource="{Binding VisibleItems}"
                     AutomationProperties.Name="扩展列表"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ExtensionCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,18,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                                        <Border Background="{DynamicResource WorkbenchSurfaceAltBrush}"
                                                CornerRadius="4" Padding="7,2" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding KindText}" Style="{StaticResource MutedTextStyle}"/>
                                        </Border>
                                        <TextBlock Text="{Binding StatusText}"
                                                   Foreground="{DynamicResource WorkbenchPrimaryBrush}"
                                                   FontSize="12" Margin="10,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}"
                                               Style="{StaticResource MutedTextStyle}"
                                               TextWrapping="Wrap" Margin="0,7,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource MutedTextStyle}"/>
                                        <TextBlock Text="{Binding PublisherText}" Style="{StaticResource MutedTextStyle}" Margin="16,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{Binding ToggleText}"
                                            Command="{Binding DataContext.ToggleEnabledCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding ToggleVisibility}"
                                            AutomationProperties.Name="切换扩展启用状态"/>
                                    <Button Content="打开"
                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding OpenVisibility}"
                                            AutomationProperties.Name="打开工作区扩展"/>
                                    <Button Content="{Binding InstallText}"
                                            Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding CanInstall}"
                                            Visibility="{Binding InstallVisibility}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Margin="0"
                                            AutomationProperties.Name="安装或更新扩展"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Style="{StaticResource CardStyle}"
                    Visibility="{Binding EmptyVisibility}"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{Binding EmptyTitle}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding EmptyDescription}"
                               Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource WorkbenchErrorOverlayBrush}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="320">
                    <ProgressBar IsIndeterminate="True" Height="6"/>
                    <TextBlock Text="{Binding BusyText}" TextAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
