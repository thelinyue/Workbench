<UserControl x:Class="HephaestusWorkbench.App.Views.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="760" HorizontalAlignment="Left">
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><StackPanel>
            <TextBlock Text="界面主题" Style="{StaticResource SectionTitleStyle}"/>
            <TextBlock Text="选择工作台的显示主题，保存后立即生效。" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,8"/>
            <ComboBox ItemsSource="{Binding ThemeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding SelectedTheme, UpdateSourceTrigger=PropertyChanged}" Width="160" HorizontalAlignment="Left"/>
        </StackPanel></Border>
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><StackPanel>
            <TextBlock Text="日志监控目录" Style="{StaticResource SectionTitleStyle}"/>
            <TextBlock Text="程序会扫描以下目录中符合命名规则的 .tgz 文件。" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,8"/>
            <ListBox ItemsSource="{Binding WatchDirectories}" SelectedItem="{Binding SelectedWatchDirectory}" Height="130"/>
            <DockPanel Margin="0,10,0,0">
                <Button DockPanel.Dock="Right" Content="浏览" Click="BrowseWatchDirectory_Click"/>
                <TextBox Text="{Binding NewWatchDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                <Button DockPanel.Dock="Right" Content="添加" Command="{Binding AddWatchDirectoryCommand}"/>
            </DockPanel>
            <Button Content="移除选中目录" Command="{Binding RemoveWatchDirectoryCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
        </StackPanel></Border>
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><StackPanel>
            <TextBlock Text="报告查看" Style="{StaticResource SectionTitleStyle}"/>
            <CheckBox Content="启动时恢复上次打开的报告" IsChecked="{Binding ReportRestoreEnabled}"/>
            <TextBlock Text="最大打开报告数量（1–10）" Style="{StaticResource MutedTextStyle}" Margin="0,10,0,5"/>
            <TextBox Text="{Binding MaxOpenReports, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left"/>
        </StackPanel></Border>
        <Button Content="保存设置" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}" HorizontalAlignment="Left"/>
        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource WorkbenchSuccessBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </StackPanel></ScrollViewer>
</UserControl>
