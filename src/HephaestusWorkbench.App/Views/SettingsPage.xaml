<UserControl x:Class="HephaestusWorkbench.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HephaestusWorkbench.App.Views"
             SizeChanged="SettingsPage_SizeChanged">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="SettingsLayout" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PrimaryColumn" Width="2*"/>
                <ColumnDefinition x:Name="SecondaryColumn" Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="WatchDirectoriesCard" Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,10,10" VerticalAlignment="Top">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="工作区" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,3"/>
                            <TextBlock Text="日志监控目录" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding WatchDirectoryCountText}" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="程序会扫描以下目录中符合命名规则的 .tgz 文件。添加或移除目录后，请点击“保存设置”使更改生效。" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <ListBox ItemsSource="{Binding WatchDirectories}" SelectedItem="{Binding SelectedWatchDirectory}" MinHeight="64" MaxHeight="150" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemContainerStyle="{StaticResource DirectoryListItemStyle}" Visibility="{Binding HasWatchDirectories, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Path}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding AvailabilityText}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Style="{StaticResource CommandStripStyle}" Visibility="{Binding HasWatchDirectories, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="尚未添加监控目录" FontWeight="SemiBold"/>
                            <TextBlock Text="添加一个目录后，程序才会扫描其中符合命名规则的 .tgz 文件。" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding NewWatchDirectory, UpdateSourceTrigger=PropertyChanged}" ToolTip="输入或粘贴目录路径，然后按 Enter 添加">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddWatchDirectoryCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Content="浏览" Click="BrowseWatchDirectory_Click" Width="88"/>
                        <Button Grid.Column="2" Content="添加目录" Command="{Binding AddWatchDirectoryCommand}" Style="{StaticResource PrimaryButtonStyle}" Width="108" Margin="0"/>
                    </Grid>
                    <TextBlock Text="{Binding DirectoryFeedback}" Style="{StaticResource InlineFeedbackStyle}" Visibility="{Binding HasDirectoryFeedback, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <DockPanel LastChildFill="False" Margin="0,12,0,0">
                        <TextBlock Text="{Binding RemoveWatchDirectoryHint}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="移除选中目录" Command="{Binding RemoveWatchDirectoryCommand}" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding RemoveWatchDirectoryHint}" Margin="0"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <StackPanel x:Name="PreferencesPanel" Grid.Row="0" Grid.Column="1" VerticalAlignment="Top">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="外观" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="调整工作台的显示主题。" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <TextBlock Text="界面主题" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding ThemeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding SelectedTheme, UpdateSourceTrigger=PropertyChanged}" Width="160" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border x:Name="SettingsActionsPanel" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource CommandStripStyle}" Margin="0,2,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="有未保存更改" Foreground="{DynamicResource WorkbenchWarningBrush}" Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource WorkbenchDangerBrush}" TextWrapping="Wrap" Visibility="{Binding MessageIsError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource WorkbenchSuccessBrush}" TextWrapping="Wrap" Visibility="{Binding MessageIsError, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="保存设置" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}" HorizontalAlignment="Right" Margin="0"/>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
