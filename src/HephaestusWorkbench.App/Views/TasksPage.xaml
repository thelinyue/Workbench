<UserControl x:Class="HephaestusWorkbench.App.Views.TasksPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel><Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Margin="0,0,0,10"><DockPanel><StackPanel><TextBlock Text="分析任务" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="查看后台任务状态并取消等待或运行中的任务" Style="{StaticResource MutedTextStyle}"/></StackPanel><WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center"><Button Content="刷新" Command="{Binding RefreshCommand}"/><Button Content="取消任务" Style="{StaticResource DangerButtonStyle}" Command="{Binding CancelCommand}" Margin="0"/></WrapPanel></DockPanel></Border>
        <Grid><ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedTask}"><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource CardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="任务" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding Id}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="案例" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding CaseId}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="插件" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding PluginId}"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="开始时间" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding StartTime, StringFormat={}{0:MM-dd HH:mm:ss}}"/></StackPanel><Border Grid.Column="4" Background="{Binding Status, Converter={StaticResource StatusBrushConverter}}" CornerRadius="10" Padding="8,3" VerticalAlignment="Center"><TextBlock Text="{Binding Status, Converter={StaticResource StatusTextConverter}}" FontSize="12"/></Border></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="36" Foreground="{DynamicResource WorkbenchMutedTextBrush}" HorizontalAlignment="Center"/><TextBlock Text="暂无分析任务" Margin="0,10,0,0" FontSize="16"/></StackPanel></Grid>
    </DockPanel>
</UserControl>
