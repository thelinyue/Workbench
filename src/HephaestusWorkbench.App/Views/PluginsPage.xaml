<UserControl x:Class="HephaestusWorkbench.App.Views.PluginsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="插件中心" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="管理本地分析插件，查看插件状态和开发入口。" Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock Text="{Binding Message}" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Content="打开插件目录" Command="{Binding OpenPluginDirectoryCommand}"/>
                    <Button Content="插件开发文档" Command="{Binding OpenDocumentationCommand}"/>
                    <Button Content="刷新插件" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RefreshCommand}" Margin="0"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="插件目录" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="1" Text="{Binding PluginDirectory}" TextWrapping="Wrap" VerticalAlignment="Center" ToolTip="{Binding PluginDirectory}"/>
                <TextBlock Grid.Column="2" Text="{Binding LastScanText}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <UniformGrid Columns="4" Margin="0,0,0,10">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="已发现" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding PluginCount}" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="EXE 插件" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding ExeCount}" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="DLL 契约" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding DllCount}" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
                    <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="扫描问题" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding IssueCount}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource WorkbenchDangerBrush}" Margin="0,5,0,0"/></StackPanel></Border>
                </UniformGrid>

                <ItemsControl ItemsSource="{Binding Issues}" Visibility="{Binding ShowIssues, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,4">
                    <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource CardStyle}" BorderBrush="{DynamicResource WorkbenchDangerBrush}" Margin="0,0,0,6"><TextBlock Text="{Binding}" Foreground="{DynamicResource WorkbenchDangerBrush}" TextWrapping="Wrap"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2.4*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="2.4*"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Id}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="版本" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding Version}" Margin="0,4,0,0"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="类型" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding Type}" Margin="0,4,0,0"/></StackPanel>
                                    <StackPanel Grid.Column="3"><TextBlock Text="入口" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding EntryPath}" TextWrapping="Wrap" ToolTip="{Binding EntryPath}" Margin="0,4,0,0"/></StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,40">
                    <TextBlock Text="&#xECAA;" FontFamily="Segoe Fluent Icons" FontSize="36" Foreground="{DynamicResource WorkbenchMutedTextBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="未发现可用插件" Margin="0,10,0,0" FontSize="16" HorizontalAlignment="Center"/>
                    <TextBlock Text="将包含 manifest.json 和入口文件的插件目录复制到上方目录后，点击“刷新插件”。" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
