<UserControl x:Class="HephaestusWorkbench.App.Views.PluginsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel><Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Margin="0,0,0,10"><DockPanel><StackPanel><TextBlock Text="分析插件" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="工作台当前可用的日志分析能力" Style="{StaticResource MutedTextStyle}"/></StackPanel><Button DockPanel.Dock="Right" Content="刷新插件" Command="{Binding RefreshCommand}" VerticalAlignment="Center"/></DockPanel></Border>
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><ItemsControl ItemsSource="{Binding Issues}" Margin="0,0,0,10"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource CardStyle}" BorderBrush="{DynamicResource WorkbenchDangerBrush}" Margin="0,0,0,6"><TextBlock Text="{Binding}" Foreground="{DynamicResource WorkbenchDangerBrush}" TextWrapping="Wrap"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Grid Grid.Row="1"><ListBox ItemsSource="{Binding Items}"><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource CardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Id}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="版本" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding Version}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="类型" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding Type}"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="入口" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding EntryPath}"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="&#xECAA;" FontFamily="Segoe Fluent Icons" FontSize="36" Foreground="{DynamicResource WorkbenchMutedTextBrush}" HorizontalAlignment="Center"/><TextBlock Text="未发现可用插件" Margin="0,10,0,0" FontSize="16"/></StackPanel></Grid></Grid>
    </DockPanel>
</UserControl>
