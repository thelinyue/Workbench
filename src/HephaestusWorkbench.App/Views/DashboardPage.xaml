<UserControl x:Class="HephaestusWorkbench.App.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10" Visibility="{Binding ShowFirstUseGuide, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="前往设置" Command="{Binding OpenSettingsCommand}"/>
                    <StackPanel>
                        <TextBlock Text="首次使用" FontWeight="SemiBold"/>
                        <TextBlock Text="可直接在首页选择或拖入 .tgz 日志；监控目录中的日志也会自动出现在最近列表。" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <UniformGrid Columns="3" Margin="0,0,0,10">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,7,0"><StackPanel><TextBlock Text="案例数量" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding CaseCount}" FontSize="26" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,7,0"><StackPanel><TextBlock Text="数据占用" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding UsedSpace}" FontSize="26" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="可释放" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding ReleasableSpace}" FontSize="26" FontWeight="SemiBold" Margin="0,7,0,0" Foreground="{DynamicResource WorkbenchWarningBrush}"/></StackPanel></Border>
            </UniformGrid>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="快速分析日志" Style="{StaticResource SectionTitleStyle}"/>
                    <Border Background="{DynamicResource WorkbenchSurfaceAltBrush}"
                            BorderBrush="{DynamicResource WorkbenchBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="14"
                            AllowDrop="True"
                            DragOver="OnQuickDragOver"
                            Drop="OnQuickDrop">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Content="选择日志并分析"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    IsEnabled="{Binding CanStartQuickAnalysis}"
                                    Click="OnSelectLogClick"
                                    Margin="12,0,0,0"/>
                            <StackPanel>
                                <TextBlock Text="将一个 .tgz 日志拖到这里" FontWeight="SemiBold"/>
                                <TextBlock Text="也可以选择监控目录外的日志；分析成功后会自动打开报告。" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TextBlock Text="注意：工作台会原地接管所选日志；以后清理或删除案例时会删除原日志及其同名解压目录。"
                               Foreground="{DynamicResource WorkbenchWarningBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <StackPanel Visibility="{Binding HasQuickStatus, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,8,0,0">
                        <TextBlock Text="{Binding QuickStatusMessage}" Foreground="{DynamicResource WorkbenchDangerBrush}" TextWrapping="Wrap" Visibility="{Binding QuickStatusIsError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding QuickStatusMessage}" Foreground="{DynamicResource WorkbenchPrimaryBrush}" TextWrapping="Wrap" Visibility="{Binding QuickStatusIsError, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding QuickSourcePath}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,3,0,0" Visibility="{Binding HasQuickSourcePath, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="查看全部日志" Command="{Binding OpenInboxCommand}" Margin="8,0,0,0"/>
                        <StackPanel>
                            <TextBlock Text="最近日志" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                            <TextBlock Text="监控目录中最近 5 个可分析日志" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding RecentLogs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource WorkbenchBorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="135"/>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding DetailMessage}" Foreground="{DynamicResource WorkbenchDangerBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,8,0" Visibility="{Binding HasDetailMessage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="16,0,0,0"><TextBlock Text="设备" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding DeviceId}" Margin="0,3,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="2" Margin="16,0,0,0"><TextBlock Text="日志时间" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding LogTime, StringFormat={}{0:MM-dd HH:mm}}" Margin="0,3,0,0"/><TextBlock Text="{Binding FileSizeText}" Style="{StaticResource MutedTextStyle}" Margin="0,2,0,0"/></StackPanel>
                                        <Border Grid.Column="3" Background="{Binding State, Converter={StaticResource StatusBrushConverter}}" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding StatusText}" FontSize="12"/></Border>
                                        <WrapPanel Grid.Column="4" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <Button Content="{Binding ActionText}" Command="{Binding PrimaryCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="84" Margin="0"/>
                                            <Button Content="解压目录" Command="{Binding OpenExtractDirectoryCommand}" Margin="6,0,0,0" Visibility="{Binding HasExtractDirectory, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="当前监控目录没有可分析日志" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" Margin="0,18" Visibility="{Binding ShowNoRecentLogs, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <DockPanel Margin="0,8,0,0" Visibility="{Binding HasInvalidInboxItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button DockPanel.Dock="Right" Content="查看异常日志" Command="{Binding OpenInboxCommand}" Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding InvalidInboxCount, StringFormat=发现 {0} 个命名不合规、损坏或无法读取的日志。}" Foreground="{DynamicResource WorkbenchWarningBrush}" VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,7,0"><StackPanel><TextBlock Text="最近案例" Style="{StaticResource SectionTitleStyle}"/><ItemsControl ItemsSource="{Binding RecentCases}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource WorkbenchBorderBrush}" BorderThickness="0,0,0,1" Padding="0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding DeviceId}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding UpdateTime, StringFormat={}{0:MM-dd HH:mm}}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/><Border Grid.Column="2" Background="{Binding Status, Converter={StaticResource StatusBrushConverter}}" CornerRadius="10" Padding="8,3"><TextBlock Text="{Binding Status, Converter={StaticResource StatusTextConverter}}" FontSize="12"/></Border></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="暂无分析案例" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" Margin="0,18" Visibility="{Binding ShowNoCases, Converter={StaticResource BooleanToVisibilityConverter}}"/></StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="运行任务" Style="{StaticResource SectionTitleStyle}"/><ItemsControl ItemsSource="{Binding CurrentTasks}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource WorkbenchBorderBrush}" BorderThickness="0,0,0,1" Padding="0,8"><StackPanel><TextBlock Text="{Binding CaseId}"/><Border Background="{Binding Status, Converter={StaticResource StatusBrushConverter}}" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" Margin="0,5,0,0"><TextBlock Text="{Binding Status, Converter={StaticResource StatusTextConverter}}" FontSize="12"/></Border></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="当前没有运行中的任务" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" Margin="0,18" Visibility="{Binding ShowNoTasks, Converter={StaticResource BooleanToVisibilityConverter}}"/></StackPanel></Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
