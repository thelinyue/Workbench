<UserControl x:Class="HephaestusWorkbench.App.Views.ReportViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid Background="White">
        <wv2:WebView2 x:Name="Browser" />
        <Border Background="{DynamicResource WorkbenchErrorOverlayBrush}" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" x:Name="ErrorPanel">
            <TextBlock Text="{Binding LoadError}" Foreground="{DynamicResource WorkbenchTextBrush}" TextWrapping="Wrap" MaxWidth="520"/>
        </Border>
    </Grid>
</UserControl>
