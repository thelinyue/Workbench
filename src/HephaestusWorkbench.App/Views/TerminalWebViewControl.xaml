<UserControl x:Class="HephaestusWorkbench.App.Views.TerminalWebViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             AutomationProperties.Name="SSH 交互终端">
    <Grid Background="#0F1720">
        <wv2:WebView2 x:Name="Browser" />
        <Border x:Name="ErrorPanel" Background="{DynamicResource WorkbenchSurfaceBrush}" Visibility="Collapsed" Padding="24">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                <TextBlock Text="终端显示不可用" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock x:Name="ErrorText" Style="{StaticResource MutedTextStyle}" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
