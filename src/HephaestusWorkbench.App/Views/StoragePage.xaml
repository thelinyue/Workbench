<UserControl x:Class="HephaestusWorkbench.App.Views.StoragePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel><StackPanel DockPanel.Dock="Top"><UniformGrid Columns="5" Margin="0,0,0,10"><Border Style="{StaticResource CardStyle}" Margin="0,0,6,0"><StackPanel><TextBlock Text="数据总占用" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding TotalSpace}" FontSize="20" Margin="0,6,0,0"/></StackPanel></Border><Border Style="{StaticResource CardStyle}" Margin="0,0,6,0"><StackPanel><TextBlock Text="可释放" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding ReleasableSpace}" FontSize="20" Foreground="{DynamicResource WorkbenchWarningBrush}" Margin="0,6,0,0"/></StackPanel></Border><Border Style="{StaticResource CardStyle}" Margin="0,0,6,0"><StackPanel><TextBlock Text="日志文件" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding LogSpace}" FontSize="20" Margin="0,6,0,0"/></StackPanel></Border><Border Style="{StaticResource CardStyle}" Margin="0,0,6,0"><StackPanel><TextBlock Text="解压文件" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding ExtractSpace}" FontSize="20" Margin="0,6,0,0"/></StackPanel></Border><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="报告" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding ReportSpace}" FontSize="20" Margin="0,6,0,0"/></StackPanel></Border></UniformGrid><Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><DockPanel><StackPanel><TextBlock Text="按案例清理" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="清理原始日志和解压目录，报告会保留" Style="{StaticResource MutedTextStyle}"/></StackPanel><WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center"><Button Content="刷新" Command="{Binding RefreshCommand}"/><Button Content="清理选中案例" Style="{StaticResource DangerButtonStyle}" Command="{Binding CleanCommand}" Margin="0"/></WrapPanel></DockPanel></Border></StackPanel>
        <ListBox ItemsSource="{Binding Cases}" SelectedItem="{Binding SelectedCase}"><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource CardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding DeviceId}" Style="{StaticResource MutedTextStyle}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding OriginalName}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/><Border Grid.Column="2" Background="{Binding Status, Converter={StaticResource StatusBrushConverter}}" CornerRadius="10" Padding="8,3"><TextBlock Text="{Binding Status, Converter={StaticResource StatusTextConverter}}" FontSize="12"/></Border></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
    </DockPanel>
</UserControl>
