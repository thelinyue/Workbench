<UserControl x:Class="HephaestusWorkbench.App.Views.AnalysisCenterPage"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True"
             Drop="OnFilesDropped">
    <UserControl.Resources>
        <Style x:Key="CompactButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <DataTemplate x:Key="PendingAnalysisRowTemplate">
            <Border BorderBrush="{DynamicResource WorkbenchBorderBrush}" BorderThickness="0,0,0,1" Padding="10,9">
                <Grid MouseLeftButtonDown="OnLogRowMouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="Auto" MinWidth="260"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SourcePath}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding InboxError}" Foreground="{DynamicResource WorkbenchDangerBrush}" FontSize="12" Margin="0,3,0,0" Visibility="{Binding HasInboxError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Border Background="{Binding StatusValue, Converter={StaticResource StatusBrushConverter}}" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding StatusText}" FontSize="12"/>
                        </Border>
                        <TextBlock Text="{Binding LastActivityTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding CurrentAttempt.AnalysisScopeText}" Style="{StaticResource MutedTextStyle}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button Content="{Binding SingleAnalysisText}" Style="{StaticResource CompactButtonStyle}" Command="{Binding DataContext.AnalyzeSingleCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                        <Button Content="取消" Style="{StaticResource CompactButtonStyle}" Command="{Binding DataContext.CancelAnalysisCommand, ElementName=Root}" CommandParameter="{Binding}" Visibility="{Binding CanCancelAnalysis, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Button Content="打开报告" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding DataContext.OpenRowReportCommand, ElementName=Root}" CommandParameter="{Binding}" Margin="0,0,6,0"/>
                        <Menu Background="Transparent" VerticalAlignment="Center">
                            <MenuItem Header="更多">
                                <MenuItem Header="打开文件位置" Command="{Binding DataContext.OpenExtractDirectoryCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                <MenuItem Header="报告位置" Command="{Binding DataContext.OpenReportFolderCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                <Separator/>
                                <MenuItem Header="删除全部数据" Foreground="{DynamicResource WorkbenchDangerBrush}" Command="{Binding DataContext.DeleteLifecycleCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                            </MenuItem>
                        </Menu>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="HistoryAnalysisRowTemplate">
            <Border BorderBrush="{DynamicResource WorkbenchBorderBrush}" BorderThickness="0,0,0,1" Padding="10,9">
                <Grid MouseLeftButtonDown="OnLogRowMouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="Auto" MinWidth="260"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SourcePath}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource WorkbenchDangerBrush}" FontSize="12" Margin="0,3,0,0" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Border Background="{Binding StatusValue, Converter={StaticResource StatusBrushConverter}}" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding StatusText}" FontSize="12"/>
                        </Border>
                        <TextBlock Text="{Binding ActivityTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding AnalysisScopeText}" Style="{StaticResource MutedTextStyle}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button Content="打开报告" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding DataContext.OpenRowReportCommand, ElementName=Root}" CommandParameter="{Binding}" Margin="0,0,6,0"/>
                        <Button Content="打开文件位置" Style="{StaticResource CompactButtonStyle}" Command="{Binding DataContext.OpenExtractDirectoryCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                        <Menu Background="Transparent" VerticalAlignment="Center">
                            <MenuItem Header="更多">
                                <MenuItem Header="报告位置" Command="{Binding DataContext.OpenReportFolderCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                            </MenuItem>
                        </Menu>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="分析中心" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                <TextBlock Text="快速分析完成后，将在电脑默认浏览器中打开报告。" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="刷新" Command="{Binding RefreshCommand}" VerticalAlignment="Center"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource WorkspacePanelStyle}" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="快速分析" FontWeight="SemiBold" FontSize="16"/>
                    <TextBlock Text="将 .tgz 或 .tgz.temp 诊断日志拖放到此处，或选择一个日志文件。" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding SupportsStorageAnalysis, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="分析范围：" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}"/>
                        <ComboBox Width="140" Margin="6,0,0,0" ItemsSource="{Binding AvailableAnalysisScopes}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedAnalysisScope}" AutomationProperties.Name="分析范围"/>
                    </StackPanel>
                    <TextBlock Text="{Binding SelectedAnalysisScopeText, StringFormat=当前将执行：{0}}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="选择日志文件" Style="{StaticResource PrimaryButtonStyle}" Click="OnSelectLogFileClick" VerticalAlignment="Center" AutomationProperties.Name="选择日志文件"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <TabControl>
                <TabItem Header="待分析">
                    <ListBox ItemsSource="{Binding PendingItems}" ItemTemplate="{StaticResource PendingAnalysisRowTemplate}" BorderThickness="0"/>
                </TabItem>
                <TabItem Header="历史记录">
                    <DockPanel>
                        <ComboBox DockPanel.Dock="Top" Width="130" HorizontalAlignment="Left" Margin="0,0,0,8" ItemsSource="{Binding HistoryScopeFilters}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedHistoryScopeFilter}" AutomationProperties.Name="历史分析范围筛选"/>
                        <ListBox ItemsSource="{Binding HistoryItems}" ItemTemplate="{StaticResource HistoryAnalysisRowTemplate}" BorderThickness="0"/>
                    </DockPanel>
                </TabItem>
            </TabControl>
            <TextBlock Text="暂无日志分析记录" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</UserControl>
