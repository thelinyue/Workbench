<UserControl x:Class="HephaestusWorkbench.App.Views.AnalysisCenterPage"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:HephaestusWorkbench.App.Views">
    <UserControl.Resources>
        <Style x:Key="CompactButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="CompactPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="CompactDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DangerButtonStyle}">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="MoreMenuStyle" TargetType="Menu">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MoreMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource WorkbenchTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource WorkbenchSurfaceAltBrush}"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid Visibility="{Binding Reports.IsLibraryVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="刷新" Command="{Binding RefreshCommand}" Margin="8,0,0,0"/>
                        <StackPanel>
                            <TextBlock Text="日志分析生命周期" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                            <TextBlock Text="筛选日志后可批量分析待处理项，或清理无效日志" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <WrapPanel>
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="搜索" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" Width="210" Margin="0" ToolTip="搜索日志、案例、路径或插件"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="设备 ID" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding DeviceId, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="状态" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" DisplayMemberPath="Name" Width="145" Margin="0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="插件" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding PluginOptions}" SelectedItem="{Binding SelectedPlugin}" DisplayMemberPath="Name" Width="150" Margin="0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="开始日期" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding StartDate}" Width="130" Margin="0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="结束日期" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding EndDate}" Width="130" Margin="0"/>
                        </StackPanel>
                    </WrapPanel>

                    <DockPanel Margin="0,2,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="{Binding BulkEligibleCount, StringFormat=分析全部待分析（{0}）}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding AnalyzeAllPendingCommand}"/>
                            <Button Content="{Binding InvalidDeleteCount, StringFormat=删除异常日志（{0}）}"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Command="{Binding DeleteFilteredInvalidCommand}"
                                    Margin="0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource WorkbenchWarningBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="{DynamicResource WorkbenchSurfaceAltBrush}" BorderBrush="{DynamicResource WorkbenchBorderBrush}" BorderThickness="1" Padding="12,8" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="140"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="Auto" MinWidth="214"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="日志" Style="{StaticResource MutedTextStyle}"/>
                        <TextBlock Grid.Column="1" Text="设备 / 时间" Style="{StaticResource MutedTextStyle}"/>
                        <TextBlock Grid.Column="2" Text="状态" Style="{StaticResource MutedTextStyle}"/>
                        <TextBlock Grid.Column="3" Text="分析记录" Style="{StaticResource MutedTextStyle}"/>
                        <TextBlock Grid.Column="4" Text="操作" Style="{StaticResource MutedTextStyle}"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource WorkbenchSurfaceBrush}" BorderBrush="{DynamicResource WorkbenchBorderBrush}" BorderThickness="1" CornerRadius="3">
                                    <StackPanel>
                                        <Grid Margin="12,9" MouseLeftButtonDown="OnLogRowMouseLeftButtonDown">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="140"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="72"/>
                                                <ColumnDefinition Width="Auto" MinWidth="214"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="14" ToolTip="{Binding FileName}"/>
                                                <TextBlock Text="{Binding SourcePath}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" ToolTip="{Binding SourcePath}"/>
                                                <TextBlock Text="{Binding InboxError}" Foreground="{DynamicResource WorkbenchDangerBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" Visibility="{Binding HasInboxError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding DeviceId}" ToolTip="{Binding DeviceId}"/>
                                                <TextBlock Text="{Binding LogTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <Border Background="{Binding StatusValue, Converter={StaticResource StatusBrushConverter}}" CornerRadius="10" Padding="8,3">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="12"/>
                                                </Border>
                                                <TextBlock Text="{Binding SourceStateText}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" ToolTip="{Binding SourceStateText}"/>
                                            </StackPanel>

                                            <Button Grid.Column="3"
                                                    Content="{Binding Attempts.Count, StringFormat={}{0} 次}"
                                                    Style="{StaticResource CompactButtonStyle}"
                                                    Command="{Binding DataContext.ToggleHistoryCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="打开报告"
                                                        Style="{StaticResource CompactPrimaryButtonStyle}"
                                                        Command="{Binding DataContext.OpenRowReportCommand, ElementName=Root}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="打开解压目录"
                                                        Style="{StaticResource CompactButtonStyle}"
                                                        Command="{Binding DataContext.OpenExtractDirectoryCommand, ElementName=Root}"
                                                        CommandParameter="{Binding}"/>
                                                <Menu Style="{StaticResource MoreMenuStyle}" ToolTip="更多操作">
                                                    <MenuItem Header="&#xE712;" FontFamily="Segoe Fluent Icons" Style="{StaticResource MoreMenuItemStyle}">
                                                        <MenuItem Header="{Binding SingleAnalysisText}" Command="{Binding DataContext.AnalyzeSingleCommand, RelativeSource={RelativeSource AncestorType=Menu}}" CommandParameter="{Binding}"/>
                                                        <Separator/>
                                                        <MenuItem Header="报告位置" Command="{Binding DataContext.OpenReportFolderCommand, RelativeSource={RelativeSource AncestorType=Menu}}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="仅删除原始日志" Command="{Binding DataContext.DeleteSourceCommand, RelativeSource={RelativeSource AncestorType=Menu}}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="删除全部数据" Foreground="{DynamicResource WorkbenchDangerBrush}" Command="{Binding DataContext.DeleteLifecycleCommand, RelativeSource={RelativeSource AncestorType=Menu}}" CommandParameter="{Binding}"/>
                                                    </MenuItem>
                                                </Menu>
                                            </StackPanel>
                                        </Grid>

                                        <Border Background="{DynamicResource WorkbenchSurfaceAltBrush}" BorderBrush="{DynamicResource WorkbenchBorderBrush}" BorderThickness="0,1,0,0" Padding="12,10" Visibility="{Binding IsHistoryExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <TextBlock Text="历次分析记录" FontWeight="SemiBold" Margin="0,0,0,7"/>
                                                <ItemsControl ItemsSource="{Binding Attempts}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{DynamicResource WorkbenchBorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" MinWidth="180"/>
                                                                        <ColumnDefinition Width="120"/>
                                                                        <ColumnDefinition Width="110"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <StackPanel Margin="0,0,12,0">
                                                                        <TextBlock Text="{Binding Case.DisplayName}" FontWeight="SemiBold" Visibility="{Binding IsRenaming, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                                                        <DockPanel Visibility="{Binding IsRenaming, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
                                                                                <Button Content="保存" Style="{StaticResource CompactPrimaryButtonStyle}" Command="{Binding DataContext.RenameCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                                                                <Button Content="取消" Style="{StaticResource CompactButtonStyle}" Command="{Binding DataContext.CancelRenameCommand, ElementName=Root}" CommandParameter="{Binding}" Margin="0"/>
                                                                            </StackPanel>
                                                                            <TextBox Text="{Binding DataContext.CaseName, ElementName=Root, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>
                                                                        </DockPanel>
                                                                        <TextBlock Text="{Binding PluginName}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0"/>
                                                                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource WorkbenchDangerBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                    </StackPanel>

                                                                    <Border Grid.Column="1" Background="{Binding StatusValue, Converter={StaticResource StatusBrushConverter}}" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding StatusValue, Converter={StaticResource StatusTextConverter}}" FontSize="12"/>
                                                                    </Border>
                                                                    <TextBlock Grid.Column="2" Text="{Binding ActivityTime, StringFormat={}{0:MM-dd HH:mm}}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>

                                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <Button Content="打开报告" Style="{StaticResource CompactPrimaryButtonStyle}" Command="{Binding DataContext.OpenAttemptReportCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                                                        <Menu Style="{StaticResource MoreMenuStyle}" ToolTip="更多操作">
                                                                            <MenuItem Header="&#xE712;" FontFamily="Segoe Fluent Icons" Style="{StaticResource MoreMenuItemStyle}">
                                                                                <MenuItem Header="重命名" Command="{Binding DataContext.BeginRenameCommand, RelativeSource={RelativeSource AncestorType=Menu}}" CommandParameter="{Binding}"/>
                                                                                <MenuItem Header="打开解压目录" Command="{Binding DataContext.OpenExtractDirectoryCommand, RelativeSource={RelativeSource AncestorType=Menu}}" CommandParameter="{Binding}"/>
                                                                                <MenuItem Header="报告位置" Command="{Binding DataContext.OpenReportFolderCommand, RelativeSource={RelativeSource AncestorType=Menu}}" CommandParameter="{Binding}"/>
                                                                            </MenuItem>
                                                                        </Menu>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons" FontSize="34" Foreground="{DynamicResource WorkbenchMutedTextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="暂无匹配的日志分析记录" FontSize="16" Margin="0,10,0,0"/>
                        <TextBlock Text="调整筛选条件或将日志放入监控目录" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <views:ReportPage DataContext="{Binding Reports}" Visibility="{Binding Reports.IsLibraryVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
    </Grid>
</UserControl>
