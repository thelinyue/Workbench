<UserControl x:Class="HephaestusWorkbench.App.Views.AnalysisCenterPage"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="CompactButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="CompactPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="MoreMenuStyle" TargetType="Menu">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MoreMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource WorkbenchTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource WorkbenchSurfaceAltBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style x:Key="AnalysisRowItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowBorder"
                                Background="{DynamicResource WorkbenchSurfaceBrush}"
                                BorderBrush="{DynamicResource WorkbenchBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource WorkbenchHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource WorkbenchSelectedBrush}"/>
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource WorkbenchPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="AnalysisListHost" Visibility="{Binding Reports.IsLibraryVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource WorkspacePanelStyle}" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="分析中心" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                        <TextBlock Text="按源日志管理分析、报告和完整数据生命周期" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="{Binding BulkEligibleCount}" ContentStringFormat="分析全部待分析（{0}）" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AnalyzeAllPendingCommand}" VerticalAlignment="Center" Margin="8,0,8,0"/>
                    <Menu Grid.Column="2" Style="{StaticResource MoreMenuStyle}" ToolTip="危险操作" VerticalAlignment="Center">
                        <MenuItem Header="危险操作" Style="{StaticResource MoreMenuItemStyle}">
                            <MenuItem Header="{Binding InvalidDeleteCount}" HeaderStringFormat="删除异常日志（{0}）" Foreground="{DynamicResource WorkbenchDangerBrush}" Command="{Binding DataContext.DeleteInvalidCommand, ElementName=Root}"/>
                            <MenuItem Header="立即清理到期报告" Foreground="{DynamicResource WorkbenchDangerBrush}" Command="{Binding DataContext.CleanupExpiredCommand, ElementName=Root}" IsEnabled="{Binding DataContext.CleanupEnabled, ElementName=Root}"/>
                        </MenuItem>
                    </Menu>
                    <Button Grid.Column="3" Content="刷新" Command="{Binding RefreshCommand}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
                <TextBlock Grid.Row="1" Text="{Binding Message}" Foreground="{DynamicResource WorkbenchWarningBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </Grid>
        </Border>

        <Border x:Name="AnalysisMetricsStrip" Grid.Row="1" Style="{StaticResource MetricStripStyle}" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="总占用" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding TotalSpace}" Style="{StaticResource MetricValueStyle}"/></StackPanel>
                <Border Grid.Column="1" Width="1" Background="{DynamicResource WorkbenchBorderBrush}" Margin="12,0"/>
                <StackPanel Grid.Column="2"><TextBlock Text="可释放" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding ReleasableSpace}" Style="{StaticResource MetricValueStyle}" Foreground="{DynamicResource WorkbenchWarningBrush}"/></StackPanel>
                <Border Grid.Column="3" Width="1" Background="{DynamicResource WorkbenchBorderBrush}" Margin="12,0"/>
                <StackPanel Grid.Column="4"><TextBlock Text="原始日志" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding LogSpace}" Style="{StaticResource MetricValueStyle}"/></StackPanel>
                <Border Grid.Column="5" Width="1" Background="{DynamicResource WorkbenchBorderBrush}" Margin="12,0"/>
                <StackPanel Grid.Column="6"><TextBlock Text="解压内容" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding ExtractSpace}" Style="{StaticResource MetricValueStyle}"/></StackPanel>
                <Border Grid.Column="7" Width="1" Background="{DynamicResource WorkbenchBorderBrush}" Margin="12,0"/>
                <StackPanel Grid.Column="8"><TextBlock Text="报告" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding ReportSpace}" Style="{StaticResource MetricValueStyle}"/></StackPanel>
            </Grid>
        </Border>

        <Expander Grid.Row="2" Header="存储管理" IsExpanded="False" Margin="0,0,0,8">
            <Border Style="{StaticResource CommandStripStyle}" Padding="10,8" Margin="0,6,0,0">
                <WrapPanel VerticalAlignment="Center">
                    <CheckBox Content="启用到期报告清理" IsChecked="{Binding CleanupEnabled}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <TextBlock Text="保留天数" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding CleanupRetentionDays, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="64" VerticalContentAlignment="Center" ToolTip="请输入 1 到 7 天" Margin="0,0,8,0"/>
                    <Button Content="保存清理策略" Command="{Binding SaveCleanupSettingsCommand}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding CleanupSettingsMessage}" Foreground="{DynamicResource WorkbenchWarningBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </WrapPanel>
            </Border>
        </Expander>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Style="{StaticResource CommandStripStyle}" Padding="10,8" Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="100"/><ColumnDefinition Width="150"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto" MinWidth="180"/></Grid.ColumnDefinitions>
                    <TextBlock Text="日志 / 来源" Style="{StaticResource TableHeaderStyle}"/>
                    <TextBlock Grid.Column="1" Text="设备 / 时间" Style="{StaticResource TableHeaderStyle}"/>
                    <TextBlock Grid.Column="2" Text="状态" Style="{StaticResource TableHeaderStyle}"/>
                    <TextBlock Grid.Column="3" Text="操作" Style="{StaticResource TableHeaderStyle}"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <ListBox ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem}"
                         ItemContainerStyle="{StaticResource AnalysisRowItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Grid Margin="10,9" MouseLeftButtonDown="OnLogRowMouseLeftButtonDown">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="100"/><ColumnDefinition Width="150"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto" MinWidth="180"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="14" ToolTip="{Binding FileName}"/>
                                        <TextBlock Text="{Binding SourcePath}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" ToolTip="{Binding SourcePath}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding InboxError}" Foreground="{DynamicResource WorkbenchDangerBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" Visibility="{Binding HasInboxError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding DeviceId}" ToolTip="{Binding DeviceId}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding LogTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Border Background="{Binding StatusValue, Converter={StaticResource StatusBrushConverter}}" CornerRadius="10" Padding="8,3">
                                            <TextBlock Text="{Binding StatusText}" FontSize="12"/>
                                        </Border>
                                        <TextBlock Text="{Binding SourceStateText}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" ToolTip="{Binding SourceStateText}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="{Binding Attempts.Count}" ContentStringFormat="历史（{0}）" Style="{StaticResource CompactButtonStyle}" Command="{Binding DataContext.ToggleHistoryCommand, ElementName=Root}" CommandParameter="{Binding}" ToolTip="展开或收起该日志的历史分析记录"/>
                                        <Button Content="打开报告" Style="{StaticResource CompactPrimaryButtonStyle}" Command="{Binding DataContext.OpenRowReportCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                        <Menu Style="{StaticResource MoreMenuStyle}" ToolTip="更多操作">
                                            <MenuItem Style="{StaticResource MoreMenuItemStyle}">
                                                <MenuItem.Header><TextBlock Text="&#xE712;" FontFamily="Segoe Fluent Icons"/></MenuItem.Header>
                                                <MenuItem Header="{Binding SingleAnalysisText}" Command="{Binding DataContext.AnalyzeSingleCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                                <MenuItem Header="打开解压目录" Command="{Binding DataContext.OpenExtractDirectoryCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                                <Separator/>
                                                <MenuItem Header="报告位置" Command="{Binding DataContext.OpenReportFolderCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                                <MenuItem Header="删除全部数据" Foreground="{DynamicResource WorkbenchDangerBrush}" Command="{Binding DataContext.DeleteLifecycleCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                            </MenuItem>
                                        </Menu>
                                    </StackPanel>
                                </Grid>

                                <Border Background="{DynamicResource WorkbenchSurfaceAltBrush}" BorderBrush="{DynamicResource WorkbenchBorderBrush}" BorderThickness="0,1,0,0" Padding="12,10" Visibility="{Binding IsHistoryExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="历次分析记录" FontWeight="SemiBold" Margin="0,0,0,7"/>
                                        <ItemsControl ItemsSource="{Binding Attempts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource WorkbenchBorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="180"/><ColumnDefinition Width="120"/><ColumnDefinition Width="110"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <StackPanel Margin="0,0,12,0">
                                                                <TextBlock Text="{Binding Case.DisplayName}" FontWeight="SemiBold" Visibility="{Binding IsRenaming, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                                                <DockPanel Visibility="{Binding IsRenaming, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
                                                                        <Button Content="保存" Style="{StaticResource CompactPrimaryButtonStyle}" Command="{Binding DataContext.RenameCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                                                        <Button Content="取消" Style="{StaticResource CompactButtonStyle}" Command="{Binding DataContext.CancelRenameCommand, ElementName=Root}" CommandParameter="{Binding}" Margin="0"/>
                                                                    </StackPanel>
                                                                    <TextBox Text="{Binding DataContext.CaseName, ElementName=Root, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>
                                                                </DockPanel>
                                                                <TextBlock Text="{Binding PluginName}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0"/>
                                                                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource WorkbenchDangerBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            </StackPanel>
                                                            <Border Grid.Column="1" Background="{Binding StatusValue, Converter={StaticResource StatusBrushConverter}}" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding StatusValue, Converter={StaticResource StatusTextConverter}}" FontSize="12"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="2" Text="{Binding ActivityTime, StringFormat={}{0:MM-dd HH:mm}}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Button Content="打开报告" Style="{StaticResource CompactPrimaryButtonStyle}" Command="{Binding DataContext.OpenAttemptReportCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                                                <Menu Style="{StaticResource MoreMenuStyle}" ToolTip="更多操作">
                                                                    <MenuItem Style="{StaticResource MoreMenuItemStyle}">
                                                                        <MenuItem.Header><TextBlock Text="&#xE712;" FontFamily="Segoe Fluent Icons"/></MenuItem.Header>
                                                                        <MenuItem Header="重命名" Command="{Binding DataContext.BeginRenameCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                                                        <MenuItem Header="打开解压目录" Command="{Binding DataContext.OpenExtractDirectoryCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                                                        <MenuItem Header="报告位置" Command="{Binding DataContext.OpenReportFolderCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                                                    </MenuItem>
                                                                </Menu>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons" FontSize="34" Foreground="{DynamicResource WorkbenchMutedTextBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="暂无匹配的日志分析记录" FontSize="16" Margin="0,10,0,0"/>
                    <TextBlock Text="将日志放入监控目录，或从首页直接选择日志开始分析" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
