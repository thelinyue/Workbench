<UserControl x:Class="HephaestusWorkbench.App.Views.AnalysisCenterPage"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:HephaestusWorkbench.App.Views">
    <UserControl.Resources>
        <Style x:Key="CompactButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="CompactPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="MoreMenuStyle" TargetType="Menu">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MoreMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource WorkbenchTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource WorkbenchSurfaceAltBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid x:Name="AnalysisListHost" Visibility="{Binding Reports.IsLibraryVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="分析中心" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                            <TextBlock Text="查看当前报告、处理分析任务并管理存储" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,8,0" Visibility="Collapsed">
                            <Button Content="{Binding BulkEligibleCount}"
                                    ContentStringFormat="分析全部待分析（{0}）"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding AnalyzeAllPendingCommand}"/>
                            <Button Content="{Binding InvalidDeleteCount}"
                                    ContentStringFormat="删除异常日志（{0}）"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Command="{Binding DeleteInvalidCommand}"
                                    Margin="0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="刷新" Command="{Binding RefreshCommand}" VerticalAlignment="Center"/>
                    </Grid>
                    <UniformGrid Columns="5" Margin="0,0,0,10">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0"><StackPanel><TextBlock Text="数据总占用" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding TotalSpace}" FontSize="18" Margin="0,5,0,0"/></StackPanel></Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0"><StackPanel><TextBlock Text="可释放" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding ReleasableSpace}" FontSize="18" Foreground="{DynamicResource WorkbenchWarningBrush}" Margin="0,5,0,0"/></StackPanel></Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0"><StackPanel><TextBlock Text="原始日志" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding LogSpace}" FontSize="18" Margin="0,5,0,0"/></StackPanel></Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0"><StackPanel><TextBlock Text="解压内容" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding ExtractSpace}" FontSize="18" Margin="0,5,0,0"/></StackPanel></Border>
                        <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="报告" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding ReportSpace}" FontSize="18" Margin="0,5,0,0"/></StackPanel></Border>
                    </UniformGrid>
                    <Border Background="{DynamicResource WorkbenchSurfaceAltBrush}" BorderBrush="{DynamicResource WorkbenchBorderBrush}" BorderThickness="1" Padding="10,8" Margin="0,0,0,10">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="清理策略" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <CheckBox Content="启用到期报告清理" IsChecked="{Binding CleanupEnabled}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <TextBlock Text="保留天数" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding CleanupRetentionDays, UpdateSourceTrigger=PropertyChanged}" Width="64" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="保存清理策略" Command="{Binding SaveCleanupSettingsCommand}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding CleanupSettingsMessage}" Foreground="{DynamicResource WorkbenchWarningBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </WrapPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,2">
                        <Button Content="{Binding BulkEligibleCount}" ContentStringFormat="分析全部待分析（{0}）" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AnalyzeAllPendingCommand}" Margin="0,0,8,0"/>
                        <Button Content="{Binding InvalidDeleteCount}" ContentStringFormat="删除异常日志（{0}）" Style="{StaticResource DangerButtonStyle}" Command="{Binding DeleteInvalidCommand}" Margin="0,0,8,0"/>
                        <Button Content="立即清理到期报告" Style="{StaticResource DangerButtonStyle}" Command="{Binding CleanupExpiredCommand}" IsEnabled="{Binding CleanupEnabled}" Margin="0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Message}" Foreground="{DynamicResource WorkbenchWarningBrush}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="{DynamicResource WorkbenchSurfaceAltBrush}" BorderBrush="{DynamicResource WorkbenchBorderBrush}" BorderThickness="1" Padding="12,8" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="100"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="Auto" MinWidth="180"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="日志" Style="{StaticResource MutedTextStyle}"/>
                        <TextBlock Grid.Column="1" Text="设备 / 时间" Style="{StaticResource MutedTextStyle}"/>
                        <TextBlock Grid.Column="2" Text="状态" Style="{StaticResource MutedTextStyle}"/>
                        <TextBlock Grid.Column="3" Text="分析记录" Style="{StaticResource MutedTextStyle}" Visibility="Collapsed"/>
                        <TextBlock Grid.Column="4" Text="操作" Style="{StaticResource MutedTextStyle}"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListBox Grid.Row="0" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource WorkbenchSurfaceBrush}" BorderBrush="{DynamicResource WorkbenchBorderBrush}" BorderThickness="1" CornerRadius="3">
                                    <StackPanel>
                                        <Grid Margin="12,9" MouseLeftButtonDown="OnLogRowMouseLeftButtonDown">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="100"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="Auto" MinWidth="180"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="14" ToolTip="{Binding FileName}"/>
                                                <TextBlock Text="{Binding SourcePath}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" ToolTip="{Binding SourcePath}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding InboxError}" Foreground="{DynamicResource WorkbenchDangerBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" Visibility="{Binding HasInboxError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding DeviceId}" ToolTip="{Binding DeviceId}"/>
                                                <TextBlock Text="{Binding LogTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <Border Background="{Binding StatusValue, Converter={StaticResource StatusBrushConverter}}" CornerRadius="10" Padding="8,3">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="12"/>
                                                </Border>
                                                <TextBlock Text="{Binding SourceStateText}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" ToolTip="{Binding SourceStateText}"/>
                                            </StackPanel>

                                            <Button Grid.Column="3" Visibility="Collapsed"
                                                    Content="{Binding Attempts.Count}"
                                                    ContentStringFormat="{}{0} 次"
                                                    Style="{StaticResource CompactButtonStyle}"
                                                    Command="{Binding DataContext.ToggleHistoryCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="打开报告"
                                                        Style="{StaticResource CompactPrimaryButtonStyle}"
                                                        Command="{Binding DataContext.OpenRowReportCommand, ElementName=Root}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="打开解压目录"
                                                        Style="{StaticResource CompactButtonStyle}"
                                                        Command="{Binding DataContext.OpenExtractDirectoryCommand, ElementName=Root}"
                                                        CommandParameter="{Binding}"/>
                                                <Menu Style="{StaticResource MoreMenuStyle}" ToolTip="更多操作">
                                                    <MenuItem Style="{StaticResource MoreMenuItemStyle}">
                                                        <MenuItem.Header>
                                                            <TextBlock Text="&#xE712;" FontFamily="Segoe Fluent Icons"/>
                                                        </MenuItem.Header>
                                                        <MenuItem Header="{Binding SingleAnalysisText}" Command="{Binding DataContext.AnalyzeSingleCommand, RelativeSource={RelativeSource AncestorType=Menu}}" CommandParameter="{Binding}"/>
                                                        <Separator/>
                                                        <MenuItem Header="报告位置" Command="{Binding DataContext.OpenReportFolderCommand, RelativeSource={RelativeSource AncestorType=Menu}}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="删除全部数据" Foreground="{DynamicResource WorkbenchDangerBrush}" Command="{Binding DataContext.DeleteLifecycleCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                                    </MenuItem>
                                                </Menu>
                                            </StackPanel>
                                        </Grid>

                                        <Border Background="{DynamicResource WorkbenchSurfaceAltBrush}" BorderBrush="{DynamicResource WorkbenchBorderBrush}" BorderThickness="0,1,0,0" Padding="12,10" Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock Text="历次分析记录" FontWeight="SemiBold" Margin="0,0,0,7"/>
                                                <ItemsControl ItemsSource="{Binding Attempts}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{DynamicResource WorkbenchBorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" MinWidth="180"/>
                                                                        <ColumnDefinition Width="120"/>
                                                                        <ColumnDefinition Width="110"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <StackPanel Margin="0,0,12,0">
                                                                        <TextBlock Text="{Binding Case.DisplayName}" FontWeight="SemiBold" Visibility="{Binding IsRenaming, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                                                        <DockPanel Visibility="{Binding IsRenaming, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
                                                                                <Button Content="保存" Style="{StaticResource CompactPrimaryButtonStyle}" Command="{Binding DataContext.RenameCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                                                                <Button Content="取消" Style="{StaticResource CompactButtonStyle}" Command="{Binding DataContext.CancelRenameCommand, ElementName=Root}" CommandParameter="{Binding}" Margin="0"/>
                                                                            </StackPanel>
                                                                            <TextBox Text="{Binding DataContext.CaseName, ElementName=Root, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>
                                                                        </DockPanel>
                                                                        <TextBlock Text="{Binding PluginName}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0"/>
                                                                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource WorkbenchDangerBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                    </StackPanel>

                                                                    <Border Grid.Column="1" Background="{Binding StatusValue, Converter={StaticResource StatusBrushConverter}}" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding StatusValue, Converter={StaticResource StatusTextConverter}}" FontSize="12"/>
                                                                    </Border>
                                                                    <TextBlock Grid.Column="2" Text="{Binding ActivityTime, StringFormat={}{0:MM-dd HH:mm}}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>

                                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <Button Content="打开报告" Style="{StaticResource CompactPrimaryButtonStyle}" Command="{Binding DataContext.OpenAttemptReportCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                                                        <Menu Style="{StaticResource MoreMenuStyle}" ToolTip="更多操作">
                                                                            <MenuItem Style="{StaticResource MoreMenuItemStyle}">
                                                                                <MenuItem.Header>
                                                                                    <TextBlock Text="&#xE712;" FontFamily="Segoe Fluent Icons"/>
                                                                                </MenuItem.Header>
                                                                                <MenuItem Header="重命名" Command="{Binding DataContext.BeginRenameCommand, RelativeSource={RelativeSource AncestorType=Menu}}" CommandParameter="{Binding}"/>
                                                                                <MenuItem Header="打开解压目录" Command="{Binding DataContext.OpenExtractDirectoryCommand, RelativeSource={RelativeSource AncestorType=Menu}}" CommandParameter="{Binding}"/>
                                                                                <MenuItem Header="报告位置" Command="{Binding DataContext.OpenReportFolderCommand, RelativeSource={RelativeSource AncestorType=Menu}}" CommandParameter="{Binding}"/>
                                                                            </MenuItem>
                                                                        </Menu>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons" FontSize="34" Foreground="{DynamicResource WorkbenchMutedTextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="暂无匹配的日志分析记录" FontSize="16" Margin="0,10,0,0"/>
                        <TextBlock Text="调整筛选条件或将日志放入监控目录" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="Collapsed">
                        <Button Content="{Binding BulkEligibleCount}" ContentStringFormat="分析全部待分析（{0}）" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AnalyzeAllPendingCommand}" Margin="0,0,8,0"/>
                        <Button Content="{Binding InvalidDeleteCount}" ContentStringFormat="删除异常日志（{0}）" Style="{StaticResource DangerButtonStyle}" Command="{Binding DeleteInvalidCommand}" Margin="0,0,8,0"/>
                        <Button Content="立即清理到期报告" Style="{StaticResource DangerButtonStyle}" Command="{Binding CleanupExpiredCommand}" IsEnabled="{Binding CleanupEnabled}" Margin="0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <views:ReportPage x:Name="ReportWorkspaceHost"
                          DataContext="{Binding Reports}"
                          Visibility="{Binding DataContext.Reports.IsLibraryVisible, ElementName=Root, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
    </Grid>
</UserControl>
