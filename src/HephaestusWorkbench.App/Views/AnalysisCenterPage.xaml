<UserControl x:Class="HephaestusWorkbench.App.Views.AnalysisCenterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:HephaestusWorkbench.App.Views">
    <Grid>
        <Grid Visibility="{Binding Reports.IsLibraryVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="刷新" Command="{Binding RefreshCommand}" Margin="8,0,0,0"/>
                        <StackPanel>
                            <TextBlock Text="日志分析生命周期" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                            <TextBlock Text="一份日志集中查看待分析状态、历次案例、任务和报告" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <WrapPanel>
                        <TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" Width="210" ToolTip="搜索日志、案例、路径或插件"/>
                        <TextBox Text="{Binding DeviceId, UpdateSourceTrigger=PropertyChanged}" Width="140" ToolTip="设备 ID"/>
                        <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" DisplayMemberPath="Name" Width="145"/>
                        <ComboBox ItemsSource="{Binding PluginOptions}" SelectedItem="{Binding SelectedPlugin}" DisplayMemberPath="Name" Width="150"/>
                        <DatePicker SelectedDate="{Binding StartDate}" Width="130" ToolTip="开始日期"/>
                        <DatePicker SelectedDate="{Binding EndDate}" Width="130" ToolTip="结束日期"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding Message}" Foreground="{DynamicResource WorkbenchWarningBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="3*" MinWidth="360"/><ColumnDefinition Width="10"/><ColumnDefinition Width="2*" MinWidth="290"/></Grid.ColumnDefinitions>
                <Grid>
                    <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
                        <ListBox.ItemTemplate><DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="125"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock Text="{Binding SourcePath}" Style="{StaticResource MutedTextStyle}" Margin="0,4,12,0" ToolTip="{Binding SourcePath}"/>
                                        <TextBlock Text="{Binding InboxError}" Foreground="{DynamicResource WorkbenchDangerBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,12,0" Visibility="{Binding HasInboxError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0">
                                        <TextBlock Text="{Binding DeviceId}"/>
                                        <TextBlock Text="{Binding LogTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Attempts.Count, StringFormat=分析记录 {0} 次}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                        <Border Background="{Binding StatusValue, Converter={StaticResource StatusBrushConverter}}" CornerRadius="10" Padding="8,3" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding StatusText}" FontSize="12"/>
                                        </Border>
                                        <TextBlock Text="{Binding SourceStateText}" Style="{StaticResource MutedTextStyle}" Margin="0,7,0,0" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons" FontSize="34" Foreground="{DynamicResource WorkbenchMutedTextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="暂无匹配的日志分析记录" FontSize="16" Margin="0,10,0,0"/>
                        <TextBlock Text="调整筛选条件或将日志放入监控目录" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedItem.FileName}" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="源日志" Style="{StaticResource MutedTextStyle}"/>
                            <TextBlock Text="{Binding SelectedItem.SourcePath}" TextWrapping="Wrap" Margin="0,4,0,12" ToolTip="{Binding SelectedItem.SourcePath}"/>
                            <WrapPanel Margin="0,0,0,14">
                                <Button Content="{Binding SelectedItem.PrimaryActionText}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding PrimaryCommand}"/>
                                <Button Content="仅删除原始日志" Command="{Binding DeleteSourceCommand}"/>
                                <Button Content="删除全部数据" Style="{StaticResource DangerButtonStyle}" Command="{Binding DeleteLifecycleCommand}" Margin="0"/>
                            </WrapPanel>

                            <TextBlock Text="历次分析记录" Style="{StaticResource SectionTitleStyle}"/>
                            <ListBox ItemsSource="{Binding SelectedItem.Attempts}" SelectedItem="{Binding SelectedAttempt}" MaxHeight="190" Margin="0,0,0,12">
                                <ListBox.ItemTemplate><DataTemplate>
                                    <Border BorderBrush="{DynamicResource WorkbenchBorderBrush}" BorderThickness="0,0,0,1" Padding="4,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Case.DisplayName}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding PluginName}" Style="{StaticResource MutedTextStyle}" Margin="0,3,8,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <Border Background="{Binding StatusValue, Converter={StaticResource StatusBrushConverter}}" CornerRadius="10" Padding="8,3"><TextBlock Text="{Binding StatusValue, Converter={StaticResource StatusTextConverter}}" FontSize="12"/></Border>
                                                <TextBlock Text="{Binding ActivityTime, StringFormat={}{0:MM-dd HH:mm}}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Visibility="{Binding HasSelectedAttempt, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="案例名称" Style="{StaticResource MutedTextStyle}"/>
                                <DockPanel Margin="0,5,0,10">
                                    <Button DockPanel.Dock="Right" Content="保存名称" Command="{Binding RenameCommand}" Margin="8,0,0,0"/>
                                    <TextBox Text="{Binding CaseName, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>
                                </DockPanel>
                                <TextBlock Text="{Binding SelectedAttempt.ErrorMessage}" Foreground="{DynamicResource WorkbenchDangerBrush}" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="{Binding SelectedAttempt.HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <WrapPanel>
                                    <Button Content="打开报告" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OpenReportCommand}"/>
                                    <Button Content="打开解压目录" Command="{Binding OpenExtractDirectoryCommand}"/>
                                    <Button Content="报告位置" Command="{Binding OpenReportFolderCommand}" Margin="0"/>
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <views:ReportPage DataContext="{Binding Reports}" Visibility="{Binding Reports.IsLibraryVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
    </Grid>
</UserControl>
