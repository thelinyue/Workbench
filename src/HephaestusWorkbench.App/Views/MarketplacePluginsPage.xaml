<UserControl x:Class="HephaestusWorkbench.App.Views.MarketplacePluginsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="插件中心" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="从官方目录安全安装分析插件，并管理当前默认插件。" Style="{StaticResource MutedTextStyle}" />
                    <TextBlock Text="{Binding Message}" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LastRefreshText}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" />
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Content="打开规则目录" Command="{Binding OpenRulesDirectoryCommand}" />
                    <Button Content="添加本地规则" Command="{Binding ImportRuleCommand}" />
                    <Button Content="上传规则" ToolTip="{Binding UploadRulesHint}" Command="{Binding UploadRuleCommand}" IsEnabled="{Binding CanUploadRules}" />
                    <Button Content="打开插件目录" Command="{Binding OpenPluginDirectoryCommand}" />
                    <Button Content="开发文档" Command="{Binding OpenDocumentationCommand}" />
                    <Button Content="刷新" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RefreshCommand}" Margin="0" />
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="规则目录与当前状态：" Style="{StaticResource MutedTextStyle}" />
                <TextBlock Text="{Binding UploadRulesHint}" Style="{StaticResource MutedTextStyle}" Margin="8,0,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="在线插件" Style="{StaticResource SectionTitleStyle}" Margin="0,2,0,8" />
                <ItemsControl ItemsSource="{Binding OnlineItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="{Binding Plugin.Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Plugin.Description}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="版本" Style="{StaticResource MutedTextStyle}" /><TextBlock Text="{Binding VersionText}" Margin="0,4,0,0" /></StackPanel>
                                    <Button Grid.Column="2" Content="{Binding ActionText}" IsEnabled="{Binding CanInstall}" Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="在线目录暂无插件。" Visibility="{Binding ShowOnlineEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource MutedTextStyle}" Margin="0,10,0,18" />

                <TextBlock Text="已安装" Style="{StaticResource SectionTitleStyle}" Margin="0,12,0,8" />
                <ItemsControl ItemsSource="{Binding InstalledItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="{Binding Manifest.Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Manifest.Id}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" /></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="版本 / 来源" Style="{StaticResource MutedTextStyle}" /><TextBlock Margin="0,4,0,0"><Run Text="{Binding Manifest.Version, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SourceText, Mode=OneWay}" /></TextBlock></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="状态" Style="{StaticResource MutedTextStyle}" /><TextBlock Text="{Binding StatusText}" Margin="0,4,0,0" /></StackPanel>
                                    <WrapPanel Grid.Column="3" VerticalAlignment="Center">
                                        <Button Content="使用规则编辑器" Visibility="{Binding IsRuleEditor, Converter={StaticResource BooleanToVisibilityConverter}}" Command="{Binding DataContext.UseRuleEditorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Content="设为默认" Command="{Binding DataContext.SetDefaultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Content="{Binding ToggleText}" Command="{Binding DataContext.ToggleEnabledCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Content="卸载" IsEnabled="{Binding CanUninstall}" Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0" />
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="未发现已安装插件。" Visibility="{Binding ShowInstalledEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource MutedTextStyle}" Margin="0,10,0,18" />
                <ItemsControl ItemsSource="{Binding Issues}" Visibility="{Binding ShowIssues, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource CardStyle}" BorderBrush="{DynamicResource WorkbenchDangerBrush}" Margin="0,0,0,6"><TextBlock Text="{Binding}" Foreground="{DynamicResource WorkbenchDangerBrush}" TextWrapping="Wrap" /></Border></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
