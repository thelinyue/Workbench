<UserControl x:Class="HephaestusWorkbench.App.Views.CasesPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
        <DockPanel Margin="0,0,10,0"><Button DockPanel.Dock="Top" Content="刷新案例" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" Margin="0,0,0,10"/><ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedCase}"><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource CardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding DeviceId}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"/><TextBlock Text="{Binding OriginalName}" Style="{StaticResource MutedTextStyle}" Margin="0,2,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding UpdateTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/><Border Grid.Column="2" Background="{Binding Status, Converter={StaticResource StatusBrushConverter}}" CornerRadius="10" Padding="8,3" VerticalAlignment="Center"><TextBlock Text="{Binding Status, Converter={StaticResource StatusTextConverter}}" FontSize="12"/></Border></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
        <Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="案例详情" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="案例名称" Style="{StaticResource MutedTextStyle}"/><TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12"/><TextBlock Text="设备 ID" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding SelectedCase.DeviceId}" Margin="0,4,0,12"/><TextBlock Text="原始日志" Style="{StaticResource MutedTextStyle}"/><TextBlock Text="{Binding SelectedCase.OriginalName}" Margin="0,4,0,12" TextWrapping="Wrap"/><TextBlock Text="状态" Style="{StaticResource MutedTextStyle}"/><Border Background="{Binding SelectedCase.Status, Converter={StaticResource StatusBrushConverter}}" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" Margin="0,4,0,16"><TextBlock Text="{Binding SelectedCase.Status, Converter={StaticResource StatusTextConverter}}" FontSize="12"/></Border><WrapPanel><Button Content="保存名称" Command="{Binding RenameCommand}"/><Button Content="打开报告" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OpenReportCommand}"/><Button Content="打开解压目录" Command="{Binding OpenExtractDirectoryCommand}"/><Button Content="删除案例" Style="{StaticResource DangerButtonStyle}" Command="{Binding DeleteCommand}" Margin="0"/></WrapPanel></StackPanel></Border>
    </Grid>
</UserControl>
