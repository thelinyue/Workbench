<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 浅色 Command Deck：冷灰背景、白色工作面和低饱和蓝色强调。 -->
    <SolidColorBrush x:Key="WorkbenchBackgroundBrush" Color="#F4F6F8" />
    <SolidColorBrush x:Key="WorkbenchNavBrush" Color="#FAFBFC" />
    <SolidColorBrush x:Key="WorkbenchSurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="WorkbenchSurfaceAltBrush" Color="#EEF2F6" />
    <SolidColorBrush x:Key="WorkbenchBorderBrush" Color="#D8E0E8" />
    <SolidColorBrush x:Key="WorkbenchTextBrush" Color="#1B2533" />
    <SolidColorBrush x:Key="WorkbenchMutedTextBrush" Color="#667487" />
    <SolidColorBrush x:Key="WorkbenchPrimaryBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="WorkbenchAccentBrush" Color="#D97706" />
    <SolidColorBrush x:Key="WorkbenchOnPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="WorkbenchSuccessBrush" Color="#15803D" />
    <SolidColorBrush x:Key="WorkbenchDangerBrush" Color="#C62828" />
    <SolidColorBrush x:Key="WorkbenchWarningBrush" Color="#A16207" />
    <SolidColorBrush x:Key="WorkbenchInputBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="WorkbenchHoverBrush" Color="#E9F0FE" />
    <SolidColorBrush x:Key="WorkbenchSelectedBrush" Color="#DCE9FF" />
    <SolidColorBrush x:Key="WorkbenchDangerSurfaceBrush" Color="#FDE8E7" />
    <SolidColorBrush x:Key="WorkbenchErrorOverlayBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="WorkbenchStatusRunningBrush" Color="#DCE9FF" />
    <SolidColorBrush x:Key="WorkbenchStatusCompletedBrush" Color="#DCFCE7" />
    <SolidColorBrush x:Key="WorkbenchStatusFailedBrush" Color="#FDE2E2" />
    <SolidColorBrush x:Key="WorkbenchStatusWaitingBrush" Color="#FEF3C7" />
    <SolidColorBrush x:Key="WorkbenchStatusUnknownBrush" Color="#E5E7EB" />

    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource WorkbenchTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource WorkbenchBackgroundBrush}" />
    </Style>
    <Style TargetType="UserControl">
        <Setter Property="Foreground" Value="{DynamicResource WorkbenchTextBrush}" />
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource WorkbenchTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="MutedTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource WorkbenchMutedTextBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource WorkbenchTextBrush}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource WorkbenchSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WorkbenchBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="WorkspacePanelStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="CommandStripStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource WorkbenchSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WorkbenchBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style x:Key="MetricStripStyle" TargetType="Border" BasedOn="{StaticResource CommandStripStyle}">
        <Setter Property="Background" Value="{DynamicResource WorkbenchSurfaceBrush}" />
        <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style x:Key="TabStripStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource WorkbenchNavBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WorkbenchBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style x:Key="TableHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="11" />
    </Style>
    <Style x:Key="MetricValueStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource WorkbenchTextBrush}" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,3,0,0" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource WorkbenchTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource WorkbenchSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WorkbenchBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Background" Value="{DynamicResource WorkbenchHoverBrush}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource WorkbenchPrimaryBrush}" /><Setter TargetName="Border" Property="BorderThickness" Value="2" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Border" Property="Opacity" Value="0.78" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Border" Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{DynamicResource WorkbenchOnPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource WorkbenchPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WorkbenchPrimaryBrush}" />
    </Style>
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{DynamicResource WorkbenchDangerBrush}" />
        <Setter Property="Background" Value="{DynamicResource WorkbenchDangerSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WorkbenchDangerBrush}" />
    </Style>
    <Style x:Key="InlineFeedbackStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource WorkbenchMutedTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource WorkbenchSurfaceAltBrush}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,10,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Style.Triggers><DataTrigger Binding="{Binding DirectoryFeedbackIsError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WorkbenchDangerBrush}" /><Setter Property="Background" Value="{DynamicResource WorkbenchDangerSurfaceBrush}" /></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="DirectoryListItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="Margin" Value="0,0,0,6" /><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource WorkbenchBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12,9"><ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource WorkbenchHoverBrush}" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource WorkbenchSelectedBrush}" /><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource WorkbenchPrimaryBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource WorkbenchTextBrush}" /><Setter Property="Background" Value="{DynamicResource WorkbenchInputBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource WorkbenchBorderBrush}" /><Setter Property="CaretBrush" Value="{DynamicResource WorkbenchPrimaryBrush}" /><Setter Property="Padding" Value="9,7" /><Setter Property="Margin" Value="0,0,8,0" /><Setter Property="MinHeight" Value="32" />
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource WorkbenchTextBrush}" /><Setter Property="Background" Value="{DynamicResource WorkbenchInputBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource WorkbenchBorderBrush}" /><Setter Property="Padding" Value="7,5" /><Setter Property="Margin" Value="0,0,8,0" /><Setter Property="MinHeight" Value="32" />
    </Style>
    <Style TargetType="DatePicker"><Setter Property="Foreground" Value="{DynamicResource WorkbenchTextBrush}" /><Setter Property="Background" Value="{DynamicResource WorkbenchInputBrush}" /><Setter Property="Margin" Value="0,0,8,0" /><Setter Property="MinHeight" Value="32" /></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource WorkbenchTextBrush}" /><Setter Property="Margin" Value="0,5" /></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Foreground" Value="{DynamicResource WorkbenchTextBrush}" /></Style>
    <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,6" /><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource WorkbenchTextBrush}" /></Style>
    <Style TargetType="ScrollViewer"><Setter Property="Background" Value="Transparent" /></Style>
</ResourceDictionary>
