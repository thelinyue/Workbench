<Application x:Class="HephaestusWorkbench.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HephaestusWorkbench.App.ViewModels"
             xmlns:views="clr-namespace:HephaestusWorkbench.App.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/LightTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" xmlns:local="clr-namespace:HephaestusWorkbench.App" />
        <local:StatusTextConverter x:Key="StatusTextConverter" xmlns:local="clr-namespace:HephaestusWorkbench.App" />
        <local:StatusBrushConverter x:Key="StatusBrushConverter" xmlns:local="clr-namespace:HephaestusWorkbench.App" />
        <DataTemplate DataType="{x:Type vm:AnalysisCenterViewModel}"><views:AnalysisCenterPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SshTerminalViewModel}"><views:SshTerminalPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExtensionCenterViewModel}"><views:ExtensionCenterPage /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
