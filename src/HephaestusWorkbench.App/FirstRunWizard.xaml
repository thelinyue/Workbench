<Window x:Class="HephaestusWorkbench.App.FirstRunWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HephaestusWorkbench.App"
        Title="Hephaestus工作台 - 首次配置" Height="620" Width="820"
        MinHeight="560" MinWidth="760" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Icon="Assets/AppIcon/app-icon.ico">
    <Window.Resources>
        <local:StepVisibilityConverter x:Key="StepVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="欢迎使用 Hephaestus工作台" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="首次运行配置向导" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" />
            <TextBlock Text="{Binding StepText}" HorizontalAlignment="Right" Style="{StaticResource MutedTextStyle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <Grid>
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=0}">
                    <TextBlock Text="准备开始" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="向导将帮助你选择分析数据目录和日志监控目录，并创建全新的 v2 数据库与配置文件。" TextWrapping="Wrap" />
                    <TextBlock Text="现有数据目录和案例不会被覆盖；初始化过程可以安全重试。" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,14,0,0" />
                </StackPanel>

                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=1}">
                    <TextBlock Text="数据目录" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="数据库、案例、报告、扩展和日志将保存到此目录。请不要选择程序安装目录。" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="浏览" Command="{Binding BrowseDataPathCommand}" />
                        <TextBox Text="{Binding DataPath, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                </StackPanel>

                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=2}">
                    <Grid>
                        <TextBlock Text="日志监控目录" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                        <TextBlock Text="{Binding MonitorPathCountText}" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="工作台会扫描这些目录中符合命名规则的 .tgz 文件。默认使用数据目录下的 Inbox。可输入路径或点击浏览选择文件夹。" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <ListBox ItemsSource="{Binding MonitorPaths}" SelectedItem="{Binding SelectedMonitorPath}" Height="170" ItemContainerStyle="{StaticResource DirectoryListItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" ToolTip="{Binding}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding NewMonitorPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="输入或粘贴目录路径，然后按 Enter 添加">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddMonitorCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Content="浏览" Command="{Binding BrowseMonitorPathCommand}" Width="88" />
                        <Button Grid.Column="2" Content="添加目录" Command="{Binding AddMonitorCommand}" Style="{StaticResource PrimaryButtonStyle}" Width="108" Margin="0" />
                    </Grid>
                    <TextBlock Text="{Binding DirectoryFeedback}" Style="{StaticResource InlineFeedbackStyle}" />
                    <DockPanel Margin="0,12,0,0">
                        <TextBlock Text="{Binding RemoveMonitorHint}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Content="移除选中目录" Command="{Binding RemoveMonitorCommand}" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding RemoveMonitorHint}" Margin="0" />
                    </DockPanel>
                </StackPanel>

                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=3}">
                    <TextBlock Text="初始化工作台" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{Binding ProgressMessage}" TextWrapping="Wrap" />
                    <ProgressBar IsIndeterminate="{Binding IsBusy}" Height="8" Margin="0,18,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,20,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource WorkbenchDangerBrush}" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="500" Margin="0,0,16,0" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="上一步" Command="{Binding BackCommand}" />
                <Button Content="{Binding NextButtonText}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding NextCommand}" Margin="0" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
